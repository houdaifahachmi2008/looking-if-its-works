# --- Jouw gegevens (komen onderaan elke mail) ---
# Verplicht: SENDER_NAME, SENDER_EMAIL, SENDER_PHONE. De rest mag je leeg laten.
# Heb je geen straat? Zet dan enkel je gemeente bij SENDER_ADDRESS (bv. 9000 Gent).
SENDER_NAME=Jan Janssens
SENDER_COMPANY=Janssens Webdesign
SENDER_EMAIL=jan@janssenswebdesign.be
SENDER_PHONE=+32 470 12 34 56
SENDER_WEBSITE=https://janssenswebdesign.be
SENDER_VAT=BE0123.456.789
SENDER_ADDRESS=Voorbeeldstraat 1, 9000 Gent

# --- SMTP (bv. Gmail met app-wachtwoord, Outlook, of je hostingprovider) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=jan@janssenswebdesign.be
SMTP_PASSWORD=app-wachtwoord-hier

# --- Optioneel: Claude schrijft dan per klant een unieke mail ---
# Zonder sleutel worden ingebouwde sjablonen gebruikt.
ANTHROPIC_API_KEY=

# --- Veiligheid ---
MAX_EMAILS_PER_DAY=30
SECONDS_BETWEEN_EMAILS=90
