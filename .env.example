# ─────────────────────────────────────────────────────────────────────────────
# ViralBot configuration. Copy to .env and fill in what you use.
# Everything is optional: with no keys at all ViralBot still runs on videos you
# drop into data/inbox, using local Whisper + heuristic scoring (cost: $0).
# Never commit your real .env.
# ─────────────────────────────────────────────────────────────────────────────

# Where the database, media, clips and logs live (default: ./data)
# VIRALBOT_DATA_DIR=./data

# ── AI analysis (LLM) ────────────────────────────────────────────────────────
# auto = Gemini if GEMINI_API_KEY is set, else OpenAI, else Ollama (if OLLAMA_MODEL set), else heuristics only
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Free local AI with Ollama (no account/key): install from ollama.com, run
#   ollama pull qwen2.5:7b      then set:
# LLM_PROVIDER=ollama
OLLAMA_MODEL=
OLLAMA_HOST=http://localhost:11434
# USD per 1M tokens, used for the dashboard cost estimate. Check your provider's
# current price list and update these.
LLM_PRICE_INPUT_PER_M=0.30
LLM_PRICE_OUTPUT_PER_M=2.50

# ── Transcription ────────────────────────────────────────────────────────────
# faster-whisper (free, local) | openai (Whisper API, ~$0.006/min) | none
TRANSCRIBE_ENGINE=faster-whisper
# tiny | base | small | medium | large-v3  (bigger = more accurate, slower)
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── YouTube ──────────────────────────────────────────────────────────────────
# API key: discovery (read-only search/statistics)
YOUTUBE_API_KEY=
# OAuth client (Desktop app) JSON from Google Cloud Console: uploads + analytics
YOUTUBE_CLIENT_SECRETS=./client_secret.json
# Your project's daily quota (default 10,000 units; one upload ≈ 1,600)
YOUTUBE_DAILY_QUOTA=10000

# ── Twitch (Helix API, app access token) ─────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Rights ───────────────────────────────────────────────────────────────────
# Channels you OWN (comma-separated YouTube channel IDs, e.g. UCxxxx)
OWNED_YOUTUBE_CHANNELS=
# Channels/broadcasters that gave you WRITTEN permission to clip & republish.
# Keep the permission on file; record it per source in the dashboard.
AUTHORIZED_YOUTUBE_CHANNELS=
AUTHORIZED_TWITCH_BROADCASTERS=
# Rights assumed for files dropped into data/inbox without a .rights.json sidecar
INBOX_DEFAULT_RIGHTS=owned

# Download platform URLs with yt-dlp, but ONLY for rights-cleared sources.
# Off by default: YouTube's Terms restrict downloading. Prefer exporting your own
# videos (YouTube Studio / Twitch VOD download) into data/inbox.
ENABLE_YTDLP=false

# ── Rendering ────────────────────────────────────────────────────────────────
# Any installed font family (fc-list). Bold/black fonts read best on mobile.
SUBTITLE_FONT=Inter Black
